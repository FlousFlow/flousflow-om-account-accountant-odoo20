<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="om_account_accountant.WorkingFileSpreadsheet" owl="1">
        <div class="o_action o_working_file_spreadsheet d-flex flex-column">
            <div class="d-flex align-items-center justify-content-between border-bottom p-2">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-secondary btn-sm"
                            t-att-disabled="state.status == 'saving'"
                            t-on-click="goBack">Back to Working File</button>
                    <h2 class="mb-0" t-esc="state.name"/>
                </div>
                <div class="d-flex align-items-center gap-2" role="status" aria-live="polite">
                    <span t-if="state.status == 'saving'">Saving…</span>
                    <span t-elif="state.status == 'dirty'">Unsaved changes</span>
                    <span t-elif="state.status == 'saved'">Saved</span>
                    <span t-elif="state.status == 'readonly'">Read only</span>
                    <span t-elif="state.status == 'error'" class="text-danger">Save failed</span>
                    <button t-if="state.error and canEdit" type="button" class="btn btn-secondary btn-sm"
                            t-on-click="retrySave">Retry</button>
                </div>
            </div>
            <div t-if="state.loading" class="d-flex flex-grow-1 align-items-center justify-content-center">
                <i class="fa fa-spinner fa-spin me-2"/> Loading spreadsheet…
            </div>
            <div t-elif="model" class="o_working_file_spreadsheet_editor flex-grow-1">
                <SpreadsheetComponent model="model"/>
            </div>
        </div>
    </t>
</templates>
